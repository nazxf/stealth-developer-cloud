# Copy to .env and replace with a locally generated secret. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-development-secret
POSTGRES_PORT=5432
API_PORT=8080
# Optional in-process HTTPS for verified Site custom domains. Keep disabled
# when a reverse proxy terminates TLS. Public ports 443/80 should route to the
# configured listeners when enabled.
ACME_ENABLED=false
ACME_EMAIL=
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_TLS_ADDR=:8443
ACME_HTTP_CHALLENGE_ADDR=:8081
ACME_CERT_CACHE_DIR=/var/lib/stealth/storage/acme
# Exposed only when starting the optional `observability` Compose profile.
PROMETHEUS_PORT=9090
# Optional OpenTelemetry OTLP/HTTP endpoint. Leave blank for no-op tracing;
# with the Compose observability profile use http://tempo:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_API_SERVICE_NAME=stealth-api
OTEL_WORKER_SERVICE_NAME=stealth-worker
# Grafana is exposed only with the observability profile.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
TEMPO_PORT=3200
LOKI_PORT=3100
# Set true behind HTTPS in production. Keep false only for local HTTP development.
COOKIE_SECURE=false
# Separate lifetime for project application-user sessions (maximum 720h).
APP_SESSION_TTL=720h
# One-time Auth link lifetimes. Keep reset links shorter than verification.
AUTH_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h
# Base URL used in verification/recovery emails. No query or fragment.
PUBLIC_APP_URL=http://localhost:3000
# disabled (default), log (local only), or smtp (production relay).
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Public project Auth protection; Redis is required by the API in production.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
REDIS_URL=redis://127.0.0.1:6379/0
# Private server-side URL used by Next.js server components and the fixed API bridge.
STEALTH_API_URL=http://127.0.0.1:8080
STEALTH_SESSION_COOKIE_NAME=stealth_session
# The API accepts IEC quantities (for example 50MiB and 1GiB). The bridge
# uses this value for its multipart request cap and adds a 2MiB envelope.
STORAGE_ROOT=/var/lib/stealth/storage
STORAGE_MAX_FILE_SIZE=50MiB
STORAGE_DEFAULT_QUOTA_BYTES=1GiB
STEALTH_STORAGE_MAX_FILE_SIZE=50MiB
# Generate once with: openssl rand -base64 32
# Required by the API. Function variable values are AES-256-GCM encrypted and
# the API refuses to become ready without this key.
FUNCTIONS_SECRET_KEY=replace-with-a-base64-encoded-32-byte-key
FUNCTIONS_MAX_ARTIFACT_SIZE=50MiB
FUNCTIONS_DEFAULT_QUOTA_BYTES=1GiB
# Matching bridge-side upload limit for manual deployment archives.
STEALTH_FUNCTIONS_MAX_ARTIFACT_SIZE=50MiB
# Sites accept pre-built static output archives or source archives with a
# build_command. Source builds run in the isolated worker and quota counts
# expanded files served from the immutable deployment directory.
SITES_MAX_ARTIFACT_SIZE=50MiB
SITES_DEFAULT_QUOTA_BYTES=1GiB
SITES_MAX_EXPANDED_BYTES=256MiB
SITES_MAX_FILES=4096
SITES_GIT_FETCH_CONCURRENCY=4
STEALTH_SITES_MAX_ARTIFACT_SIZE=50MiB
# Trusted worker settings. The worker needs the Docker socket; user code does
# not. Pin runtime images in your deployment policy before production use.
FUNCTIONS_RUNNER_ENABLED=true
FUNCTIONS_WORKER_ID=stealth-worker-1
FUNCTIONS_RUNNER_POLL=500ms
FUNCTIONS_RUNNER_LEASE_AGE=20m
FUNCTIONS_RUNNER_BUILD_TIMEOUT=15m
FUNCTIONS_RUNNER_STAGING_ROOT=/var/lib/stealth/runner-staging
FUNCTIONS_RUNNER_STAGING_VOLUME=stealth-function-runner-staging
# Private listener scraped by Prometheus inside the Compose network.
FUNCTIONS_RUNNER_METRICS_ADDR=:9091
# Pin all five image references by digest in production. The worker uses
# --pull=never, so images must already exist on the worker host.
FUNCTIONS_RUNNER_HELPER_IMAGE=alpine:3.22
FUNCTIONS_RUNNER_NODE_IMAGE=node:22-alpine
FUNCTIONS_RUNNER_PYTHON_IMAGE=python:3.13-alpine
FUNCTIONS_RUNNER_GO_IMAGE=golang:1.24-alpine
