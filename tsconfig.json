{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/vite/**/*.ts",
    "src/vite/**/*.tsx",
    "src/lib/browser-api.ts",
    "src/**/*.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
