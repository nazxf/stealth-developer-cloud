      "targets": [
        { "expr": "sum by (result) (rate(stealth_functions_worker_builds_completed_total[15m]))", "legendFormat": "build {{result}}", "refId": "A" },
        { "expr": "sum by (result) (rate(stealth_functions_worker_jobs_completed_total[15m]))", "legendFormat": "execution {{result}}", "refId": "B" }
