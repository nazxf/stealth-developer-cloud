      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(stealth_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{route}}", "refId": "A" }
      ],
      "title": "API p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "stealth-prometheus" },
