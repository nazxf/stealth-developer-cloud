{
  "name": "stealth-console",
  "description": "Stealth Console — the web console for the Stealth developer cloud platform.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:vite": "tsc --project tsconfig.vite.json --noEmit",
